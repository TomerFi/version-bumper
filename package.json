{
  "name": "@tomerfi/version-bumper",
  "version": "4.0.12",
  "description": "A Node.js executable package determining semantic version bumps based on the conventional commits spec.",
  "homepage": "https://github.com/TomerFi/version-bumper#readme",
  "license": "ISC",
  "author": {
    "name": "Tomer Figenblat",
    "url": "https://github.com/TomerFi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomerFi/version-bumper.git"
  },
  "bugs": "https://github.com/TomerFi/version-bumper/issues",
  "keywords": [
    "semver",
    "semantic version",
    "automation",
    "cli",
    "conventional commits"
  ],
  "bin": {
    "version-bumper": "src/cli.js"
  },
  "main": "src/index.js",
  "files": [
    "!*",
    "src/bumper.js"
  ],
  "type": "module",
  "engines": {
    "node": ">= 20.0.0",
    "npm": ">= 10.0.0"
  },
  "scripts": {
    "lint": "npm run eslint && npm run ec",
    "test": "mocha --check-leaks --fail-zero --color --ui tdd --recursive ./tests/",
    "test:coverage": "c8 mocha --check-leaks --fail-zero --color --ui tdd --recursive ./tests/",
    "eslint": "eslint src",
    "eslint:fix": "eslint --fix src",
    "ec": "ec",
    "link-ai-files": "aicfg link agents --to claude-code",
    "lint-staged": "lint-staged",
    "prepare": "husky || true"
  },
  "dependencies": {
    "conventional-changelog-conventionalcommits": "10.4.0",
    "conventional-recommended-bump": "12.1.0",
    "git-semver-tags": "8.0.1",
    "minimist": "1.2.8",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "aicfg": "0.2.0",
    "c8": "12.0.0",
    "chai": "4.5.0",
    "chai-as-promised": "8.0.2",
    "editorconfig-checker": "7.0.0",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "mocha": "12.0.0",
    "shelljs": "0.10.0"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "tests/**"
    ],
    "reporter": [
      "text",
      "lcov",
      "html"
    ],
    "check-coverage": false
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix --"
    ],
    "*": [
      "npm run ec --"
    ]
  }
}
